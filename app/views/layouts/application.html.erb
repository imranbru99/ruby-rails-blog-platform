<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || page_title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= content_for(:description) || site_tagline %>">
    <meta name="theme-color" content="#f7f5f0" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#0e1116" media="(prefers-color-scheme: dark)">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;0,9..144,700;1,9..144,400;1,9..144,600&family=JetBrains+Mono:wght@400;500&family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&display=swap" rel="stylesheet">
    <script>
      (function() {
        var theme = localStorage.getItem("meridian_theme");
        if (!theme) {
          theme = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        }
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="public-body" data-controller="theme">
    <a class="skip-link" href="#main">Skip to content</a>
    <%= render "shared/header" %>
    <main id="main">
      <% if notice %><p class="flash flash-notice" role="status"><span aria-hidden="true">✓</span> <%= notice %></p><% end %>
      <% if alert %><p class="flash flash-alert" role="alert"><span aria-hidden="true">⚠️</span> <%= alert %></p><% end %>
      <%= yield %>
    </main>
    <%= render "shared/footer" %>
    
    <div id="toast-container" class="toast-container">
      <div id="toast-notification" class="toast" role="status" aria-live="polite"></div>
    </div>
  </body>
</html>
